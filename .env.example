# --- Database ---
# Local development: a file database (created automatically).
DATABASE_URL=file:./data/crm.db
# Production (Turso free tier): libsql://<db-name>-<org>.turso.io
# DATABASE_AUTH_TOKEN=<turso token>

# --- Auth ---
# Long random string used to sign login cookies. Generate: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string

# The Owner (Wisam) account is created on first start if no users exist.
OWNER_USERNAME=wisam
OWNER_NAME=Wisam
OWNER_PASSWORD=change-me-now-please

# Timezone used for "today", daily/weekly/monthly report boundaries.
APP_TIMEZONE=UTC
